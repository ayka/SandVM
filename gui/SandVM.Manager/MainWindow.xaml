<Window x:Class="SandVM.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:SandVM.Manager.Models"
        Title="SandVM Yöneticisi" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar header -->
    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,1" Padding="18,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnSettings" ToolTip="Ayarlar">
          <TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE713;" FontSize="16"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="SandVM" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="Sanal makine yöneticisi" Foreground="{StaticResource SubtleBrush}" FontSize="11"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Sidebar: machine list -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}" Margin="16,14,16,10" Padding="14,9" Click="OnNew">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="White"/>
            <TextBlock Text="Yeni sanal makine"/>
          </StackPanel>
        </Button>
        <TextBlock DockPanel.Dock="Top" Text="SANAL MAKİNELER" Margin="20,6,0,6" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource SubtleBrush}"/>
        <ListBox x:Name="MachineList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource VmListItem}"
                 SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnListDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type m:VirtualMachine}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="{Binding BadgeBrush}">
                  <TextBlock Text="{Binding BadgeLetter}" Foreground="White" FontWeight="Bold" FontSize="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SubtleBrush}" FontSize="12"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="9" Height="9" Fill="{Binding StateBrush}" ToolTip="{Binding StateText}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detail header -->
    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,12">
      <Grid x:Name="HeaderPanel">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Margin="12,0,0,0" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="{StaticResource HoverBrush}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding StateText}" Margin="6,0,0,0" FontSize="12"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="OnStart" Margin="0,0,8,0" ToolTip="Sanal makineyi başlat">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="White"/>
              <TextBlock Text="Başlat"/>
            </StackPanel>
          </Button>
          <Button x:Name="ShutdownButton" Click="OnShutdown" Margin="0,0,8,0"
                  ToolTip="Misafir işletim sistemine güç düğmesine basıldığını bildirir; sistem kendini düzgünce kapatır.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;"/>
              <TextBlock Text="Kapat"/>
            </StackPanel>
          </Button>
          <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Click="OnForceStop" Margin="0,0,16,0"
                  ToolTip="Fişi çekmek gibidir: kaydedilmemiş veriler kaybolabilir.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Foreground="{StaticResource DangerBrush}"/>
              <TextBlock Text="Zorla durdur"/>
            </StackPanel>
          </Button>
          <Button x:Name="EditButton" Style="{StaticResource FlatButton}" Click="OnEdit" ToolTip="Ayarları düzenle">
            <TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE70F;" FontSize="16"/>
          </Button>
          <Button x:Name="CloneButton" Style="{StaticResource FlatButton}" Click="OnClone" ToolTip="Ayarları kopyalayarak yeni makine oluştur">
            <TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE8C8;" FontSize="16"/>
          </Button>
          <Button x:Name="DeleteButton" Style="{StaticResource FlatButton}" Click="OnDelete" ToolTip="Sil">
            <TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE74D;" FontSize="16" Foreground="{StaticResource DangerBrush}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Detail body -->
    <Grid Grid.Row="1" Grid.Column="1">
      <!-- Empty state -->
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="56" HorizontalAlignment="Center"
                   Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Henüz sanal makine yok" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}"
                   Text="Bir ISO dosyasından (Ubuntu, Lubuntu, ReactOS...) yeni bir sanal makine oluşturun ya da mevcut bir disk dosyasını kullanın."/>
        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,9" Click="OnNew">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="White"/>
            <TextBlock Text="Yeni sanal makine"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <TabControl x:Name="DetailTabs" Margin="24,8,24,16" Visibility="Collapsed">
        <TabItem Header="Genel">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.2*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Donanım"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                      </Grid.RowDefinitions>
                      <TextBlock Style="{StaticResource Label}" Text="İşletim sistemi"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Column="1" Text="{Binding OsName}"/>
                      <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Bellek"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="1" Text="{Binding RamText}"/>
                      <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="İşlemci"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="1" Text="{Binding Cpus, StringFormat={}{0} çekirdek}"/>
                      <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="Sabit disk"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Row="3" Grid.Column="1" x:Name="DiskInfoText"/>
                      <TextBlock Style="{StaticResource Label}" Grid.Row="4" Text="CD/DVD"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Row="4" Grid.Column="1" Text="{Binding CdromText}"/>
                      <TextBlock Style="{StaticResource Label}" Grid.Row="5" Text="Ağ"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Row="5" Grid.Column="1" Text="{Binding NetworkText}"/>
                      <TextBlock Style="{StaticResource Label}" Grid.Row="6" Text="Ekran"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Row="6" Grid.Column="1" Text="{Binding DisplayText}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Gelişmiş"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                      </Grid.RowDefinitions>
                      <TextBlock Style="{StaticResource Label}" Text="Sandboxie kutusu"/>
                      <TextBlock Style="{StaticResource Value}" Grid.Column="1" Text="{Binding SandboxText}"/>
                      <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Komut satırı"/>
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Padding="0,4" Click="OnCopyCommand" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Panoya kopyala" Foreground="{StaticResource AccentBrush}"/>
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Padding="12,4,0,4" Click="OnOpenFolder" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Disk klasörünü aç" Foreground="{StaticResource AccentBrush}"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,2" Click="OnSaveScreenshot"
                            x:Name="SaveScreenshotButton" ToolTip="Ekran görüntüsünü PNG olarak kaydet">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Kaydet" Foreground="{StaticResource AccentBrush}"/>
                      </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Text="Ekran"/>
                  </DockPanel>
                  <Border Background="#0B0F19" CornerRadius="6" MinHeight="240">
                    <Grid>
                      <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock x:Name="PreviewPlaceholder" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                                 Text="Makine çalışınca ekranın küçük bir kopyası burada görünür.&#x0a;Asıl ekran ayrı bir pencerede açılır."/>
                    </Grid>
                  </Border>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                             Text="İpucu: makine penceresine tıklayınca fare yakalanır, Ctrl+Alt ile bırakılır."/>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Konsol">
          <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Bottom" Margin="12">
                <Button DockPanel.Dock="Right" Click="OnClearConsole" Margin="8,0,0,0" ToolTip="Konsolu temizle">
                  <TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE74D;"/>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnSendCtrlC" Margin="8,0,0,0" ToolTip="Misafire Ctrl+C gönder">
                  <TextBlock Text="Ctrl+C"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="OnSendInput" Margin="8,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Foreground="White"/>
                    <TextBlock Text="Gönder"/>
                  </StackPanel>
                </Button>
                <TextBox x:Name="ConsoleInput" FontFamily="{StaticResource MonoFont}" KeyDown="OnConsoleInputKeyDown"
                         ToolTip="Misafirin seri konsoluna (COM1) yazılır. Enter gönderir."/>
              </DockPanel>
              <Border Background="{StaticResource ConsoleBrush}" CornerRadius="10,10,0,0">
                <TextBox x:Name="ConsoleOutput" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="12"
                         Foreground="{StaticResource ConsoleTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
              </Border>
            </DockPanel>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <TextBlock x:Name="HostText" DockPanel.Dock="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="HypervisorDot" Width="8" Height="8" Fill="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="HypervisorText" Margin="8,0,0,0" FontSize="12" Text="Hipervizör denetleniyor..."/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
