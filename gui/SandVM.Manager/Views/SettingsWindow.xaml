<Window x:Class="SandVM.Manager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="İptal" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
        <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" IsDefault="True" MinWidth="110" Click="OnOk"/>
      </StackPanel>
    </Border>
    <StackPanel Margin="20">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Program dosyaları"/>
          <TextBlock Text="sandvm.exe" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Gözat..." Margin="8,0,0,0" Click="OnBrowseSandvm"/>
            <TextBox x:Name="SandvmBox"/>
          </DockPanel>
          <TextBlock x:Name="SandvmHint" Style="{StaticResource Hint}"/>

          <TextBlock Text="BIOS (bios-256k.bin)" FontWeight="SemiBold" Margin="0,14,0,6"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Gözat..." Margin="8,0,0,0" Click="OnBrowseBios"/>
            <TextBox x:Name="BiosBox"/>
          </DockPanel>
          <TextBlock x:Name="BiosHint" Style="{StaticResource Hint}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Sanal makine klasörü"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Gözat..." Margin="8,0,0,0" Click="OnBrowseFolder"/>
            <TextBox x:Name="FolderBox"/>
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="Yeni sanal diskler buraya, her makine için ayrı bir klasöre kaydedilir. Boş bırakılırsa Belgeler\SandVM kullanılır."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
